{
  "manifest_version": 3,
  "name": "Reading Panel",
  "version": "1.1.0",
  "description": "Look up the current selection with a middle click in the Windows reading panel.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Reconnect Reading Panel" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["selection.js"],
    "all_frames": true,
    "run_at": "document_start"
  }]
}
