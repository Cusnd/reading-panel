<UserControl x:Class="ReadingPanel.UI.SecretField" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Field" Focusable="False">
    <Grid>
        <PasswordBox x:Name="Masked" Padding="10,7,40,7" PasswordChanged="PasswordChanged"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Field}"/>
        <TextBox x:Name="Plain" Padding="10,7,40,7" Visibility="Collapsed" TextChanged="PlainChanged"
                 IsUndoEnabled="False" AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Field}"/>
        <TextBlock x:Name="Placeholder" Text="输入 API key" Margin="11,0,40,0" Foreground="#888888"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
        <ToggleButton x:Name="Eye" Style="{DynamicResource IconToggle}" HorizontalAlignment="Right" Margin="0,0,5,0"
                      AutomationProperties.Name="显示密钥" ToolTip="显示密钥" Click="ToggleMask">
            <Grid Width="18" Height="16">
                <Path Data="M1,8 Q9,-3 17,8 Q9,19 1,8 Z M11.5,8 A2.5,2.5 0 1 1 6.5,8 A2.5,2.5 0 1 1 11.5,8"
                      Stroke="#666666" StrokeThickness="1.2"/>
                <Path x:Name="Slash" Data="M2,1 L16,15" Stroke="#666666" StrokeThickness="1.5" Visibility="Collapsed"/>
            </Grid>
        </ToggleButton>
    </Grid>
</UserControl>
