<Window x:Class="ReadingPanel.UI.SettingsWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ReadingPanel.UI"
    Title="Reading Panel 设置" Width="550" Height="590" WindowStartupLocation="CenterScreen"
    WindowStyle="None" ResizeMode="CanMinimize" Background="White" Foreground="#252525" FontSize="14"
    FontFamily="Segoe UI, Microsoft YaHei, Noto Sans SC, Microsoft YaHei UI" Language="zh-CN"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="Feedback" TargetType="TextBlock" BasedOn="{StaticResource Detail}">
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,2"/>
                <Setter Property="Background" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextElement.FontSize" Value="11"/><Setter Property="TextElement.Foreground" Value="#666666"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="White" BorderBrush="#EAEAEA" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="58" Margin="23,2,23,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Reading Panel" FontSize="26" FontFamily="{StaticResource HeadwordFont}"
                               FontStyle="Italic" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Badge}" Margin="10,3,0,0"><TextBlock x:Name="EditionBadge"/></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <Canvas Width="10" Height="10">
                            <Path Data="M 0.5,5 L 9.5,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" Margin="7,0,0,0" Click="CancelClick" ToolTip="关闭" AutomationProperties.Name="关闭">
                        <Canvas Width="10" Height="10">
                            <Path Data="M 1.2,1.2 L 8.8,8.8 M 8.8,1.2 L 1.2,8.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Padding="23,0,23,15" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                <ui:SegmentedPicker x:Name="Navigation" AutomationProperties.Name="设置页面"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarPaper}" Padding="22,12"
                    BorderBrush="#EAEAEA" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="取消" Width="62" IsCancel="True" Click="CancelClick"/>
                        <Button x:Name="SaveButton" Content="保存" Width="68" Margin="8,0,0,0" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" Click="SaveClick"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Template="{StaticResource WordScrollTemplate}">
                        <TextBlock x:Name="SaveError" Style="{StaticResource Feedback}" Margin="0" Foreground="#9C3B30"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Template="{StaticResource WordScrollTemplate}">
                <Grid Margin="23,18,15,4">
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="启动与通知" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:ToggleSwitch x:Name="Startup" DockPanel.Dock="Right" AutomationProperties.Name="开机自动启动"/>
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="登录 Windows 时静默启动并驻留系统托盘" Style="{StaticResource Detail}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="StartupHint" Style="{StaticResource Feedback}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ui:ToggleSwitch x:Name="Notifications" DockPanel.Dock="Right" AutomationProperties.Name="中键切换状态通知"/>
                                    <StackPanel>
                                        <TextBlock Text="中键切换状态通知" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="使用快捷键或托盘切换中键查词时显示气泡提示" Style="{StaticResource Detail}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="系统与数据" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="当前版本" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="EditionDetail" HorizontalAlignment="Right" Foreground="#666666" FontSize="13"/>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="打开数据目录" Margin="10,0,0,0" Click="OpenDirectoryClick"/>
                                    <StackPanel>
                                        <TextBlock Text="数据目录" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="DirectoryPath" Style="{StaticResource Detail}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Button x:Name="ResetPreferences" DockPanel.Dock="Right" Content="恢复默认偏好" Click="ResetPreferencesClick"/>
                                    <TextBlock Text="查词、翻译与通知偏好" Foreground="#666666" VerticalAlignment="Center" FontSize="13"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LookupPage" Visibility="Collapsed">
                        <TextBlock Text="查词方式" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:ToggleSwitch x:Name="MiddleClickEnabled" DockPanel.Dock="Right" AutomationProperties.Name="中键查询选中文字"/>
                                    <StackPanel>
                                        <TextBlock Text="中键查询选中文字" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="MouseStatus" Style="{StaticResource Detail}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <ui:SegmentedPicker DockPanel.Dock="Right" x:Name="LemmaDefault" Width="170" AutomationProperties.Name="原形释义"/>
                                    <TextBlock Text="原形释义" Style="{StaticResource RowTitle}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="快捷键" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" x:Name="LookupBadge" Style="{StaticResource Badge}"><TextBlock x:Name="LookupStatus"/></Border>
                                    <TextBlock Text="键盘查词快捷键" Style="{StaticResource RowTitle}"/>
                                </DockPanel>
                                <ui:ShortcutRecorder x:Name="LookupKeys" Margin="0,8,0,0" AutomationProperties.Name="键盘查词快捷键"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" x:Name="ToggleBadge" Style="{StaticResource Badge}"><TextBlock x:Name="ToggleStatus"/></Border>
                                    <TextBlock Text="切换中键查词的快捷键" Style="{StaticResource RowTitle}"/>
                                </DockPanel>
                                <ui:ShortcutRecorder x:Name="ToggleKeys" Margin="0,8,0,0" AutomationProperties.Name="切换中键查词的快捷键"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TranslationPage" Visibility="Collapsed">
                        <TextBlock Text="句子翻译" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <DockPanel>
                                <ui:ToggleSwitch x:Name="TranslationEnabled" DockPanel.Dock="Right" AutomationProperties.Name="启用句子翻译"/>
                                <StackPanel>
                                    <TextBlock Text="启用句子翻译" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="词典未收录短语或句子时，使用所选服务翻译" Style="{StaticResource Detail}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="翻译服务" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="TestConnection" Content="测试连接" DockPanel.Dock="Right" Click="TestConnectionClick" Margin="10,0,0,0"/>
                                    <ui:SegmentedPicker x:Name="Service" AutomationProperties.Name="翻译服务"/>
                                </DockPanel>
                                <StackPanel x:Name="CredentialRow" Margin="0,14,0,0">
                                    <TextBlock x:Name="KeyLabel" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                                    <ui:SecretField x:Name="Credential" AutomationProperties.Name="翻译 API key"/>
                                </StackPanel>
                                <StackPanel x:Name="OptionRow" Margin="0,12,0,0">
                                    <TextBlock x:Name="OptionLabel" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="Option" Tag="输入模型名称" AutomationProperties.LabeledBy="{Binding ElementName=OptionLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="ConnectionStatus" Style="{StaticResource Feedback}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SpeechPage" Visibility="Collapsed">
                        <TextBlock Text="语音" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Text="英文朗读" Style="{StaticResource RowTitle}" Margin="0,0,0,7"/>
                                <DockPanel>
                                    <Button x:Name="Preview" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PreviewClick" AutomationProperties.Name="试听">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl x:Name="PreviewIcon" Content="{StaticResource VolumeGlyph}" ContentTemplate="{StaticResource SoundIcon}"/>
                                            <TextBlock x:Name="PreviewText" Text="试听" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <ComboBox x:Name="VoiceMode" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="英文朗读"/>
                                </DockPanel>
                                <TextBlock x:Name="VoiceStatus" Style="{StaticResource Feedback}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <TextBlock Text="OpenAI API key" Style="{StaticResource RowTitle}" Margin="0,0,0,6"/>
                                <ui:SecretField x:Name="SpeechKey" AutomationProperties.Name="OpenAI API key"/>
                                <TextBlock x:Name="EnvHint" Style="{StaticResource Feedback}"/>
                                <Border Style="{StaticResource Divider}"/>
                                <DockPanel>
                                    <Button x:Name="InstallVoice" DockPanel.Dock="Right" Content="安装 John · 约 86 MB" Click="InstallClick"/>
                                    <TextBlock x:Name="PiperState" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="InstallStatus" Style="{StaticResource Feedback}"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="2,0,0,7">
                            <TextBlock x:Name="UsagePeriod" DockPanel.Dock="Right" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="本月用量" Style="{StaticResource GroupTitle}" Margin="0"/>
                        </DockPanel>
                        <Border Style="{StaticResource GroupCard}" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock x:Name="GoogleLine" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="UsageBar" Maximum="1000000" Margin="0,9,0,2" AutomationProperties.Name="Google 月度字符用量"/>
                                <TextBlock x:Name="QuotaDetail" Style="{StaticResource Detail}"/>
                                <TextBlock x:Name="OpenAILine" Style="{StaticResource Detail}" Margin="0,7,0,0"/>
                                <Expander x:Name="GoogleAccount" Header="Google 凭据与账户账单">
                                    <StackPanel>
                                        <TextBlock><Hyperlink Click="GoogleHelp" Foreground="#515151">Google 应用默认凭据（ADC）</Hyperlink></TextBlock>
                                        <TextBlock Text="Google 配额项目（可选）" Style="{StaticResource Detail}" Margin="0,12,0,5"/>
                                        <TextBox x:Name="QuotaProject" Tag="项目 ID" AutomationProperties.Name="Google 配额项目"/>
                                        <TextBlock Text="BigQuery 账单导出表（可选）" Style="{StaticResource Detail}" Margin="0,10,0,5"/>
                                        <TextBox x:Name="BillingTable" Tag="project.dataset.table" AutomationProperties.Name="BigQuery 账单导出表" TextChanged="BillingTableChanged"/>
                                        <Button x:Name="RefreshBill" Content="读取账户账单" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RefreshClick"/>
                                        <TextBlock x:Name="SpeechStatus" Style="{StaticResource Feedback}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
